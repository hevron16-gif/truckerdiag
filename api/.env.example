# Обязательно. Ключ xAI / SpaceXAI: https://console.x.ai
XAI_API_KEY=

# Опционально (значения по умолчанию уже рабочие)
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Render подставляет PORT сам. Локально по умолчанию 8000.
PORT=8000

# CORS: * или список origins через запятую
# https://truckerdiag.onrender.com,http://localhost:5500
CORS_ORIGINS=*

# 1 — отдавать web/ с того же процесса (удобно на одном сервисе Render)
SERVE_WEB=1

# 1 — подробный текст ошибок в ответе API (только для отладки)
DEBUG=0
